        }).join("");

        return `
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="px-4 py-3.5 bg-slate-100/70 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 cursor-pointer select-none hover:bg-slate-100 transition" onclick="toggleFolder('${topic.replace(/'/g, "\\'")}')">
            <div class="flex items-center gap-2.5">
              <button type="button" class="text-slate-500 transition-transform duration-200 ${isOpen ? 'rotate-90' : ''}"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg></button>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-base font-bold text-slate-900">${topic}</span>
                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">${allTopicQuestions[0]?.unitTag || getUnitTagFromTopic(topic)}</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-200/80 text-slate-700">${allTopicQuestions.length} Problems</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold ${folderSelectedCount > 0 ? 'bg-blue-100 text-blue-800 border border-blue-200' : 'bg-slate-100 text-slate-500 border border-slate-200'}">${folderSelectedCount} selected</span>
