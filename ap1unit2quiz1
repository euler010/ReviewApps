              <button type="button" onclick="selectFolderQuestions('${topic.replace(/'/g, "\\'")}', true)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white hover:bg-blue-50 text-blue-700 border border-slate-200 transition">Select All in Folder</button>
              <button type="button" onclick="selectCurrentPageQuestions(true)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white hover:bg-blue-50 text-blue-700 border border-slate-200 transition">Select All</button>
              <button type="button" onclick="selectFolderQuestions('${topic.replace(/'/g, "\\'")}', false)" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white hover:bg-slate-50 text-slate-600 border border-slate-200 transition">Unselect All</button>
