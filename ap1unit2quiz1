    // FBD Scratchpad Canvas
    let isDrawing = false, lastX = 0, lastY = 0;
    function toggleScratchpad() { document.getElementById("scratchpadDrawer").classList.toggle("hidden"); }
    function clearScratchpad() {
      const canvas = document.getElementById("fbdCanvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#ffffff"; ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = "#e2e8f0"; ctx.lineWidth = 1;
      for (let x = 20; x < canvas.width; x += 20) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
      for (let y = 20; y < canvas.height; y += 20) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }
    }
    function initScratchpadEvents() {
      const canvas = document.getElementById("fbdCanvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      clearScratchpad();
      function getPos(e) {
        const rect = canvas.getBoundingClientRect(), clientX = e.touches ? e.touches[0].clientX : e.clientX, clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: ((clientX - rect.left) / rect.width) * canvas.width, y: ((clientY - rect.top) / rect.height) * canvas.height };
      }
      function start(e) { e.preventDefault(); isDrawing = true; const pos = getPos(e); lastX = pos.x; lastY = pos.y; }
      function move(e) {
        if (!isDrawing) return;
        e.preventDefault(); const pos = getPos(e);
        ctx.beginPath(); ctx.moveTo(lastX, lastY); ctx.lineTo(pos.x, pos.y);
        ctx.strokeStyle = document.getElementById("penColorPicker").value; ctx.lineWidth = Number(document.getElementById("penWidthSelect").value); ctx.lineCap = "round"; ctx.stroke();
        lastX = pos.x; lastY = pos.y;
      }
      function stop() { isDrawing = false; }
      canvas.addEventListener("mousedown", start); canvas.addEventListener("mousemove", move); window.addEventListener("mouseup", stop);
      canvas.addEventListener("touchstart", start, { passive: false }); canvas.addEventListener("touchmove", move, { passive: false }); canvas.addEventListener("touchend", stop);
    }

    const DEFAULT_GITHUB_QUESTIONS_URL = "https://cdn.jsdelivr.net/gh/euler010/PhysicsQuestionBank@main/physics_questions_data.js";
