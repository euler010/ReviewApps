    function normalizeExternalQuestion(q, idx) {
      const resolvedTopic = q.topic || "Unit 2: Dynamics and Forces";
      return { ...q, docNum: q.docNum || q.id || `Q#${idx + 1}`, title: q.title || resolvedTopic, topic: resolvedTopic, unitTag: q.unitTag || q.tag || getUnitTagFromTopic(resolvedTopic) };
    }

    function mergeExternalQuestions(externalBank) {
      if (!Array.isArray(externalBank) || externalBank.length === 0) return;
      questionLibrary = externalBank.map((q, idx) => normalizeExternalQuestion(q, idx));
      defaultGitHubIdOrder = questionLibrary.map(q => q.id);

      try {
        const savedRaw = JSON.parse(safeGetStorage(CUSTOM_Q_STORAGE_KEY, "[]") || "[]");
        savedRaw.forEach(item => { if (!questionLibrary.some(q => q.id === item.id)) questionLibrary.push(hydrateCustomQuestion(item)); });
      } catch (e) {}

      loadSavedFolderState();
      loadSavedLibraryOrder();
      renderTagFilterPills();
      renderLibraryList();

      if (window.STANDALONE_BOOT_CONFIG) {
        const cfg = window.STANDALONE_BOOT_CONFIG;
        staticVarsStore = (cfg.staticVars && typeof cfg.staticVars === "object") ? cfg.staticVars : {};
        applyLibraryOrderArray(cfg.orderedIds || []);
        selectedQuestionIds = new Set(cfg.selectedIds || []);
        selectedQuestionsOrder = cfg.selectedIds || [];
