    function parseQuestionScriptText(rawText) {
      if (!rawText) return null;
      let cleaned = rawText.replace(/^\s*```(?:javascript|js)?\s*/i, "").replace(/\s*```\s*$/, "").trim();
      cleaned = cleaned.replace(/\}\s*(\r?\n\s*\{\s*\r?\n?\s*(?:id|docNum|tag|title)\s*:)/g, "},$1");

      const runnerSuffix = `
        ; let ret = null;
        if (typeof PHYSICS_QUESTIONS !== "undefined") ret = PHYSICS_QUESTIONS;
        else if (typeof MASTER_QUESTIONS !== "undefined") ret = MASTER_QUESTIONS;
        return ret;
      `;

      try {
        return (new Function(cleaned + runnerSuffix))();
      } catch (parseErr) {
        let pos = cleaned.length, attempts = 0;
        while ((pos = cleaned.lastIndexOf("},", pos - 1)) !== -1 && attempts < 60) {
          attempts++;
          const candidate = cleaned.slice(0, pos + 1) + "\n];" + runnerSuffix;
          try { return (new Function(candidate))(); } catch (e2) {}
        }
      }
      return null;
    }

    async function loadExternalGitHubQuestions() {
      let globalBank = null;
      try { if (typeof PHYSICS_QUESTIONS !== "undefined") globalBank = PHYSICS_QUESTIONS; } catch(e){}
      if (!globalBank) { try { if (typeof window.PHYSICS_QUESTIONS !== "undefined") globalBank = window.PHYSICS_QUESTIONS; } catch(e){} }
      if (!globalBank) { try { if (typeof MASTER_QUESTIONS !== "undefined") globalBank = MASTER_QUESTIONS; } catch(e){} }

      if (Array.isArray(globalBank) && globalBank.length > 0) {
        mergeExternalQuestions(globalBank);
        return;
      }

      const container = document.getElementById("libraryListContainer");
      if (container && questionLibrary.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center border border-slate-200 text-slate-500"><div class="inline-block w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin mb-2"></div><p class="text-sm font-semibold text-slate-700">Loading question library from GitHub...</p></div>`;
      }

      const urlsToTry = [ `${RAW_GITHUB_QUESTIONS_URL}?t=${Date.now()}`, `${DEFAULT_GITHUB_QUESTIONS_URL}?t=${Date.now()}`, DEFAULT_GITHUB_QUESTIONS_URL ];
      let bestBank = null;

      for (const url of urlsToTry) {
        try {
          const res = await fetch(url, { cache: "no-store" });
          if (!res.ok) continue;
          const text = await res.text();
          if (typeof PHYSICS_QUESTIONS === "undefined") {
            // Run the file as a normal script so the diagram code in it becomes available to the page.
            const tag = document.createElement("script");
            tag.id = "fetchedQuestionData";
            tag.text = text;
            document.head.appendChild(tag);
          }
          let parsed = null;
          try { if (typeof PHYSICS_QUESTIONS !== "undefined" && Array.isArray(PHYSICS_QUESTIONS)) parsed = PHYSICS_QUESTIONS; } catch (e) {}
          if (!parsed) parsed = parseQuestionScriptText(text);
          if (Array.isArray(parsed) && parsed.length > 0) {
            if (!bestBank || parsed.length > bestBank.length) bestBank = parsed;
            if (parsed.length >= 115) break;
          }
        } catch (err) {}
      }

      if (bestBank && bestBank.length > 0) {
        mergeExternalQuestions(bestBank);
      } else if (container && questionLibrary.length === 0) {
        container.innerHTML = `<div class="bg-rose-50 rounded-2xl p-8 text-center border border-rose-200 text-rose-700"><p class="text-sm font-bold mb-1">Unable to load questions from GitHub</p><p class="text-xs">Checked: <span class="mono">${DEFAULT_GITHUB_QUESTIONS_URL}</span></p></div>`;
      }
    }

    window.addEventListener("DOMContentLoaded", () => {
      initScratchpadEvents();
      loadExternalGitHubQuestions();
    });
  </script>


