"unit": "N",
"solve": (v) => v.m * (v.v * v.v / (2 * v.d) - G_ACCEL * Math.sin(v.theta * DEG2RAD) + v.mu * G_ACCEL * Math.cos(v.theta * DEG2RAD)),
