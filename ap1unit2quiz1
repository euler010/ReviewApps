            <button onclick="checkPartAnswer('${activeQ.id}', ${pIdx})" ${pState.completed ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white shadow-sm transition">Check Answer</button>
            ${(pState.attempts >= 1 || pState.completed) ? `<button onclick="togglePartSolution('${activeQ.id}', ${pIdx})" class="px-3 py-2 rounded-xl text-xs font-semibold bg-white text-slate-700 border border-slate-300 hover:bg-slate-100 transition">${pState.showSolution ? 'Hide Solution' : 'Guided Solution'}</button>` : ''}
