    function handleRecipeFile(ev) {
      const input = ev.target, file = input.files && input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onerror = () => { input.value = ""; showMessageModal("That file could not be read.", "Load Recipe Error"); };
      reader.onload = () => { input.value = ""; applyRecipeText(String(reader.result || "")); };
      reader.readAsText(file);
    }

    function applyRecipeText(text) {
      let recipe = null;
      try { recipe = JSON.parse(text.replace(/^﻿/, "").trim()); } catch (e) {}
      if (!recipe || typeof recipe !== "object" || !Array.isArray(recipe.questionIds)) {
        return showMessageModal("That file doesn't look like a saved recipe. Choose a recipe file that was saved with the Save Recipe button.", "Load Recipe Error");
      }
      if (!questionLibrary || questionLibrary.length === 0) {
        return showMessageModal("The question library hasn't finished loading yet. Wait a moment and try again.", "Load Recipe Error");
      }
      const have = new Set(questionLibrary.map(q => q.id));
      const seen = new Set(), ids = [], missing = [];
      recipe.questionIds.forEach(id => {
        if (seen.has(id)) return;
        seen.add(id);
        if (have.has(id)) ids.push(id); else missing.push(id);
      });
      if (ids.length === 0) return showMessageModal("None of the questions in that recipe are in the library, so nothing was loaded.", "Load Recipe Error");

      selectedQuestionIds = new Set(ids);
      selectedQuestionsOrder = ids;

      const templateName = TEMPLATE_CONFIG[recipe.template] ? recipe.template : document.getElementById("templateSelect").value;
      document.getElementById("templateSelect").value = templateName;
      const nameInput = document.getElementById("reviewAppNameInput");
      if (nameInput) nameInput.value = "";
      applyTemplateSettings(templateName);
      if (nameInput && typeof recipe.appName === "string" && recipe.appName.trim()) nameInput.value = recipe.appName.trim();

      const mode = recipe.randomizationMode === "static" ? "static" : "random";
      document.getElementById("randomizationModeSelect").value = mode;
      randomizationMode = mode;
      staticVarsStore = {};
      if (mode === "static" && recipe.staticVars && typeof recipe.staticVars === "object") {
        ids.forEach(id => { if (recipe.staticVars[id] && typeof recipe.staticVars[id] === "object") staticVarsStore[id] = recipe.staticVars[id]; });
      }

      currentLibraryPage = 1;
      renderLibraryList();
      let msg = 'Loaded "' + (recipe.appName || "your recipe") + '": ' + ids.length + (ids.length === 1 ? " question is" : " questions are") + " now selected in your saved order. Click Build a Review App to continue.";
      if (missing.length > 0) msg += " " + missing.length + (missing.length === 1 ? " question" : " questions") + " from the recipe could not be found in the library and " + (missing.length === 1 ? "was" : "were") + " skipped: " + missing.slice(0, 12).join(", ") + (missing.length > 12 ? ", and more" : "") + ".";
      showMessageModal(msg, "Recipe Loaded");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

