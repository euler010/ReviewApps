    function updatePartDraft(qId, pIdx) {
      const inst = currentReviewApp.instances[qId];
      if (!inst) return;
      const pState = inst.partStates[pIdx];
      const valEl = document.getElementById(`input-${qId}-${pIdx}`), unitEl = document.getElementById(`unit-${qId}-${pIdx}`), dirEl = document.getElementById(`dir-${qId}-${pIdx}`);
      if (valEl) pState.userVal = valEl.value;
      if (unitEl) pState.userUnit = unitEl.value;
      if (dirEl) pState.userDir = dirEl.value;
    }

    function checkNumericTolerance(userNum, expected, acceptNegative, customAbsTol = 0, customTolFn = null) {
      if (typeof customTolFn === "function") {
        const tol = customTolFn(expected);
        if (Math.abs(userNum - expected) <= tol) return true;
        if (acceptNegative && Math.abs(Math.abs(userNum) - Math.abs(expected)) <= tol) return true;
        return false;
      }
      if (customAbsTol > 0 && Math.abs(userNum - expected) <= Math.abs(expected * 0.1) + customAbsTol) return true;
      if (Math.abs(expected) < 1e-12) return Math.abs(userNum) < 1e-6;
      const relErr = Math.abs(userNum - expected) / Math.abs(expected), relErrNeg = acceptNegative ? Math.abs(Math.abs(userNum) - Math.abs(expected)) / Math.abs(expected) : 1;
      return relErr <= TOLERANCE || relErrNeg <= TOLERANCE;
    }

    // ---- FLEXIBLE UNITS -------------------------------------------------------
    // Units in the same family are interchangeable (e.g. 0.23 km = 230 m). Each unit lists its
    // family and its size relative to the family's base unit. A part is graded flexibly unless it
    // is marked strictUnit: true, or its required unit is "lb" (the question asks for pounds).
    const UNIT_FAMILIES = {
      "m": ["length", 1], "cm": ["length", 0.01], "mm": ["length", 0.001], "km": ["length", 1000],
      "m/s": ["speed", 1], "km/h": ["speed", 1 / 3.6],
      "N": ["force", 1], "kN": ["force", 1000]
    };
    function getFlexibleUnitFactor(userUnit, expectedUnit, part) {
      if (!part || part.strictUnit === true || expectedUnit === "lb" || userUnit === expectedUnit) return null;
      const a = UNIT_FAMILIES[userUnit], b = UNIT_FAMILIES[expectedUnit];
      if (!a || !b || a[0] !== b[0]) return null;
      return a[1] / b[1];   // multiply the student's number by this to express it in the expected unit
    }

    function checkPartAnswer(qId, pIdx) {
      const q = currentReviewApp.questions.find(item => item.id === qId);
      const inst = currentReviewApp.instances[qId];
      if (!q || !inst) return;
      const part = q.parts[pIdx];
      const pState = inst.partStates[pIdx];
      if (!part || !pState) return;

      updatePartDraft(qId, pIdx);
      const rawInput = pState.userVal.trim();

      if (part.solveMulti || part.multiVals) {
        const userNums = rawInput.split(",").map(s => parseFloat(s.trim())).filter(n => !Number.isNaN(n));
        if (userNums.length === 0) { pState.feedback = { correct: false, message: "Please enter numerical time value(s) separated by a comma (e.g., 1.5, 5.0)." }; renderStudentReviewApp(); return; }
        if (!pState.userUnit) { pState.feedback = { correct: false, message: "Please select the units from the dropdown menu." }; renderStudentReviewApp(); return; }
        pState.attempts++;
        const expectedList = part.solveMulti ? part.solveMulti(inst.vars) : part.multiVals.map(k => Number(inst.vars[k]));
        const tol = part.customAbsTol || 0.22;
        const matchedExpected = expectedList.filter(expVal => userNums.some(uVal => Math.abs(uVal - expVal) <= tol));
        const allUserValid = userNums.every(uVal => expectedList.some(expVal => Math.abs(uVal - expVal) <= tol));
        const expectedUnit = normalizeUnit(part.unit), unitMatches = pState.userUnit === expectedUnit;

        if (matchedExpected.length === expectedList.length && allUserValid && unitMatches) {
          pState.completed = true; currentReviewApp.streak++; safeSetStorage("ap1ReviewStreak", String(currentReviewApp.streak));
          pState.feedback = { correct: true, message: `Great job! Value(s) (${expectedList.map(r => Number(r).toFixed(2)).join(", ")} s) and units are within acceptable range.` };
          logStudentProgressToSheet(qId, pState.attempts, true);
        } else {
          currentReviewApp.streak = 0; safeSetStorage("ap1ReviewStreak", "0");
          if (matchedExpected.length === expectedList.length && allUserValid && !unitMatches) pState.feedback = { correct: false, message: `Your numerical value is correct, but check the units (expected ${expectedUnit}).` };
          else if (matchedExpected.length > 0) pState.feedback = { correct: false, message: `You found ${matchedExpected.length} correct ${matchedExpected.length === 1 ? "time" : "times"}, but ${!allUserValid ? "one or more values are incorrect. There " + (expectedList.length === 1 ? "is 1 time" : "are " + expectedList.length + " times") + " total" : "there " + (expectedList.length > 1 ? "are " + expectedList.length + " times total" : "is another point")} on the graph. Separate multiple values with a comma.` };
          else pState.feedback = { correct: false, message: "Not quite within tolerance. Check the graph carefully and separate multiple values with a comma." };
          logStudentProgressToSheet(qId, pState.attempts, false);
        }
        renderStudentReviewApp(); return;
      }

      const userNum = Number(rawInput);
      if (rawInput === "" || Number.isNaN(userNum)) { pState.feedback = { correct: false, message: "Please enter a valid numerical value (e-notation like 1.23e-4 is supported)." }; renderStudentReviewApp(); return; }
      if (!pState.userUnit) { pState.feedback = { correct: false, message: "Please select the units from the dropdown menu." }; renderStudentReviewApp(); return; }
      if (part.directionOptions && !pState.userDir) { pState.feedback = { correct: false, message: "Please select a direction from the dropdown menu." }; renderStudentReviewApp(); return; }

      pState.attempts++;
      const expected = typeof part.solve === "function" ? part.solve(inst.vars) : 0;
      const expectedUnit = normalizeUnit(part.unit), validUnits = part.acceptedUnits ? part.acceptedUnits.map(normalizeUnit) : [expectedUnit];

      let numMatches = checkNumericTolerance(userNum, expected, part.acceptNegative, part.customAbsTol || 0, part.customTol || null);
      let unitMatches = validUnits.includes(pState.userUnit), matchedDisplayVal = expected, matchedDisplayUnit = expectedUnit;

      if ((!numMatches || !unitMatches) && Array.isArray(part.altUnitSolutions)) {
        for (const alt of part.altUnitSolutions) {
          const altVal = typeof alt.solve === "function" ? alt.solve(inst.vars) : 0, altUnit = normalizeUnit(alt.unit);
          const altNumOk = checkNumericTolerance(userNum, altVal, part.acceptNegative), altUnitOk = pState.userUnit === altUnit;
          if (altNumOk && altUnitOk) { numMatches = true; unitMatches = true; matchedDisplayVal = altVal; matchedDisplayUnit = altUnit; break; }
          else if (altNumOk && !numMatches) numMatches = true;
        }
      }

      // Flexible units: if the student chose a different unit from the same family, convert their number
      // into the expected unit and grade that. This replaces the plain comparison above for that case.
      if (!(numMatches && unitMatches)) {
        const flexFactor = getFlexibleUnitFactor(pState.userUnit, expectedUnit, part);
        if (flexFactor !== null) {
          unitMatches = true;
          numMatches = checkNumericTolerance(userNum * flexFactor, expected, part.acceptNegative, part.customAbsTol || 0, part.customTol || null);
          if (numMatches) { matchedDisplayVal = expected / flexFactor; matchedDisplayUnit = pState.userUnit; }
        }
      }

      const dirMatches = !part.expectedDirection || pState.userDir === part.expectedDirection;

      if (numMatches && unitMatches && dirMatches) {
        pState.completed = true; currentReviewApp.streak++; safeSetStorage("ap1ReviewStreak", String(currentReviewApp.streak));
        pState.feedback = { correct: true, message: `Correct! Within ±1% tolerance with correct units (${fmtSci(matchedDisplayVal, 4)} ${matchedDisplayUnit === 'No units' ? 'No units' : matchedDisplayUnit}${part.expectedDirection ? ', ' + part.expectedDirection : ''}).` };
        logStudentProgressToSheet(qId, pState.attempts, true);
      } else {
        currentReviewApp.streak = 0; safeSetStorage("ap1ReviewStreak", "0");
        let hintMsg = "Not quite. Check both your numerical calculation and your selected units (or click 'Guided Solution').";
        if (numMatches && !unitMatches && dirMatches) hintMsg = "Your numerical value is correct, but check your selected units!";
        else if (numMatches && unitMatches && !dirMatches) hintMsg = "Your numerical value and units are correct, but check the direction!";
        else if (!numMatches && unitMatches && dirMatches) hintMsg = "Your units are right, but double-check your numerical calculation.";
        pState.feedback = { correct: false, message: hintMsg };
        logStudentProgressToSheet(qId, pState.attempts, false);
      }
      renderStudentReviewApp();
    }

    function togglePartSolution(qId, pIdx) {
      const inst = currentReviewApp.instances[qId];
      if (inst && inst.partStates[pIdx]) inst.partStates[pIdx].showSolution = !inst.partStates[pIdx].showSolution;
      renderStudentReviewApp();
    }

    function goToReviewQuestion(idx) { currentReviewApp.currentIndex = idx; renderStudentReviewApp(); }

    function regenerateSingleQuestion(qId) {
      if (randomizationMode === "static") return;
      const q = currentReviewApp.questions.find(item => item.id === qId);
      if (!q) return;
      currentReviewApp.instances[qId] = createQuestionInstance(q);
      // The spline graph drawing code now lives in the question data file, so check that it is present.
      if (typeof syncSplineStateWithVars === "function") {
        if (qId === "KIN-01") syncSplineStateWithVars(1, currentReviewApp.instances[qId].vars, true);
        if (qId === "KIN-02") syncSplineStateWithVars(2, currentReviewApp.instances[qId].vars, true);
      }
      renderStudentReviewApp();
    }

    function regenerateAllStudentInstances() {
      if (randomizationMode === "static") return;
      currentReviewApp.questions.forEach(q => { currentReviewApp.instances[q.id] = createQuestionInstance(q); });
      renderStudentReviewApp();
    }

    function openAddQuestionModal() { document.getElementById("addQuestionModal").classList.remove("hidden"); }
    function closeAddQuestionModal() { document.getElementById("addQuestionModal").classList.add("hidden"); }

    function saveCustomQuestion() {
      const title = document.getElementById("customQTitle").value.trim() || "Custom Physics Problem", topic = document.getElementById("customQTopic").value;
      const promptTemplate = document.getElementById("customQPrompt").value.trim();
      const v1 = Number(document.getElementById("customQV1").value || 10), v2 = Number(document.getElementById("customQV2").value || 20);
      const formula = document.getElementById("customQFormula").value.trim() || "v2 / v1", unit = normalizeUnit(document.getElementById("customQUnit").value.trim());
      const solutionText = document.getElementById("customQSolution").value.trim() || "Substitute the given values into the formula.";

      if (!promptTemplate) return showMessageModal("Please provide a question prompt.", "Missing Prompt");

      const rawItem = { id: "CUST-" + Date.now().toString().slice(-4), docNum: "Custom #" + (questionLibrary.length - 61), title, topic, promptTemplate, v1, v2, formula, unit, solutionText, unitTag: getUnitTagFromTopic(topic) };
      const savedRaw = JSON.parse(safeGetStorage(CUSTOM_Q_STORAGE_KEY, "[]") || "[]");
      savedRaw.push(rawItem); safeSetStorage(CUSTOM_Q_STORAGE_KEY, JSON.stringify(savedRaw));

      const hydrated = hydrateCustomQuestion(rawItem);
      questionLibrary.push(hydrated); selectedQuestionIds.add(hydrated.id); saveLibraryOrder();
      closeAddQuestionModal(); renderTagFilterPills(); renderLibraryList();
    }

    function hydrateCustomQuestion(item) {
      const cleanUnit = normalizeUnit(item.unit);
      if (!UNIT_OPTIONS.includes(cleanUnit)) UNIT_OPTIONS.push(cleanUnit);
      const resolvedTopic = item.topic ? item.topic.replace(/^Unit 3: Circular Motion/, "Unit 2: Circular Motion") : "Unit 2: Dynamics and Forces";
      return {
        id: item.id, docNum: item.docNum || "Custom", title: item.title, topic: resolvedTopic, unitTag: getUnitTagFromTopic(resolvedTopic),
        baseVars: { v1: Number(item.v1), v2: Number(item.v2) },
        randomize: (b) => ({ v1: rnd(b.v1, 0.2, 2), v2: rnd(b.v2, 0.2, 2) }),
        renderPrompt: (v) => item.promptTemplate.replace(/\{\{v1\}\}/g, `<strong>${v.v1}</strong>`).replace(/\{\{v2\}\}/g, `<strong>${v.v2}</strong>`),
        parts: [{ label: "Answer", unit: cleanUnit, solve: (v) => (new Function("v1", "v2", "g", "G", `return (${item.formula});`))(v.v1, v.v2, G_ACCEL, G_CONST), steps: (v, ans) => `${item.solutionText} (With <em>v</em><sub>1</sub> = ${v.v1}, <em>v</em><sub>2</sub> = ${v.v2}: Answer = ${ans.toFixed(3)} ${cleanUnit})` }]
      };
    }

    function exportLibraryJSON() {
      const exportData = { exportedAt: new Date().toISOString(), totalQuestions: questionLibrary.length, libraryOrderIds: questionLibrary.map(q => q.id), selectedIds: questionLibrary.filter(q => selectedQuestionIds.has(q.id)).map(q => q.id) };
      const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a"); a.href = url; a.download = "physics-library-folders.json"; a.click(); URL.revokeObjectURL(url);
    }

    function buildAndDownloadStandalone() {
      try {
        initializeReviewAppFromSelection();
        closeBuildModal();
        downloadStandaloneReviewApp();
      } catch (err) {
        console.error(err);
        showMessageModal("The standalone file could not be created: " + (err && err.message ? err.message : err), "Download Error");
