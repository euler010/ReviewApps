            <div class="relative flex-1 min-w-[120px]">
              <input id="input-${activeQ.id}-${pIdx}" type="text" value="${pState.userVal}" oninput="updatePartDraft('${activeQ.id}', ${pIdx})" onkeydown="if(event.key==='Enter') checkPartAnswer('${activeQ.id}', ${pIdx})" ${pState.completed ? 'disabled' : ''} placeholder="${placeholderStr}" class="w-full px-3.5 py-2 rounded-xl bg-white border border-slate-300 text-sm text-slate-900 mono focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
