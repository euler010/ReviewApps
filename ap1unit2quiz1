        const regGluedUnit = new RegExp(`\\bv\\.${k}(?=(?:m\\/s|km\\/h|km\\/hr|m\\b|cm\\b|mm\\b|km\\b|s\\b|ms\\b|kg\\b|g\\b|N\\b|kN\\b|J\\b|W\\b|seconds\\b|meters\\b|meter\\b|kilometers\\b|gram\\b|grams\\b))`, "g");
        s = s.replace(regGluedUnit, `${val} `);
        const regGluedPunct = new RegExp(`\\bv\\.${k}(?=[-&°'’<.,;:!?)\\s]|$)`, "g");
        s = s.replace(regGluedPunct, `${val}`);
        const regAny = new RegExp(`\\bv\\.${k}`, "g");
        s = s.replace(regAny, `${val} `);
      }
      return ensureHtmlTagSpacing(s);
    }

    function renderFormattedPrompt(q, overrideVars) {
      if (!q) return "";
      const v = getSampleVars(q, overrideVars);
      let raw = "";
      if (typeof q.renderPrompt === "function") {
        try { raw = q.renderPrompt(v); } catch (e) { raw = q.prompt || q.title || ""; }
      } else if (typeof q.prompt === "string") {
        raw = q.prompt;
      }
      return interpolateBrokenTokens(raw, v);
    }

    // Library preview only: some questions keep their lettered parts (a., b., c.) out of the prompt text and show them as separate answer boxes.
    // Append them here so the preview shows the whole question. (The review app already shows its own answer boxes, so it uses renderFormattedPrompt directly.)
    function renderLibraryPrompt(q, overrideVars) {
      const v = getSampleVars(q, overrideVars);
      let html = renderFormattedPrompt(q, v);
      const parts = q.parts || [];
      if (parts.length > 1 && !/(^|>|\s)a\.(\s|<)/.test(html)) {
        const labels = parts.map(p => getPartLabel(p, v));
        if (labels.every((l, i) => new RegExp("^\\s*" + String.fromCharCode(97 + i) + "\\.\\s", "i").test(l))) {
          html += labels.map(l => "<br/>" + l.replace(/^\s*([a-z])\.\s*/i, "<strong>$1.</strong> ")).join("");
        }
      }
      return html;
    }

    function getPartLabel(part, vars) {
      const raw = typeof part.getLabel === "function" ? part.getLabel(vars) : part.label;
      return interpolateBrokenTokens(raw, vars);
    }

    function rnd(base, pct = 0.20, decimals = 2) {
      const factor = 1 + (Math.random() * 2 - 1) * pct;
      return Number((base * factor).toFixed(decimals));
    }

    function fmtSci(val, sig = 3) {
      if (val === 0) return "0";
      const abs = Math.abs(val);
      if (abs >= 1e4 || abs < 1e-2) return val.toExponential(sig - 1);
      return Number(val.toPrecision(sig)).toString();
    }

    function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

    // =========================================================================
    // EXTERNAL QUESTION LIBRARY (LOADED DYNAMICALLY FROM GITHUB)
    // =========================================================================
    const INITIAL_QUESTION_LIBRARY = [];

    const CED_UNITS = [
      { prefix: "Unit 1:", tag: "Unit 1: Kinematics" },
      { prefix: "Unit 2:", tag: "Unit 2: Force and Translational Dynamics" },
      { prefix: "Unit 3:", tag: "Unit 3: Work, Energy, and Power" },
      { prefix: "Unit 4:", tag: "Unit 4: Linear Momentum" },
      { prefix: "Unit 5:", tag: "Unit 5: Torque and Rotational Dynamics" },
      { prefix: "Unit 6:", tag: "Unit 6: Energy and Momentum of Rotating Systems" },
      { prefix: "Unit 7:", tag: "Unit 7: Oscillations" },
      { prefix: "Unit 8:", tag: "Unit 8: Fluids" }
    ];

    function getUnitTagFromTopic(topic) {
      const found = CED_UNITS.find(u => topic && topic.startsWith(u.prefix));
      return found ? found.tag : "Unit 2: Force and Translational Dynamics";
    }

    let questionLibrary = [...INITIAL_QUESTION_LIBRARY];
    let selectedQuestionIds = new Set();
    let selectedQuestionsOrder = [];
    let visibleDiagramIds = new Set();
    let diagramStateBeforeArrange = null;
    let activeFilterTag = "All";
    let currentLibraryPage = 1;
    let folderOpenState = {};
    let draggedQuestionId = null;
    let draggedReorderIndex = null;
    let randomizationMode = "random";
    // Numbers chosen once for "Static Values" apps: { questionId: vars }. Saved inside exported apps so every student sees the same numbers.
    let staticVarsStore = {};

    function toggleDiagramPreview(qId) {
      if (visibleDiagramIds.has(qId)) visibleDiagramIds.delete(qId);
      else visibleDiagramIds.add(qId);
      renderLibraryList();
      const reorderView = document.getElementById("reorderView");
      if (reorderView && !reorderView.classList.contains("hidden")) renderReorderList();
    }

    let currentReviewApp = {
      name: "AP Physics 1 — Dynamics and Circular Motion Review",
      template: "AP Physics 1",
      questions: [],
      instances: {},
      currentIndex: 0,
      streak: Number(safeGetStorage("ap1ReviewStreak", "0") || 0),
      webAppUrl: safeGetStorage("ap1TeacherWebappUrl", "") || ""
    };

    function getUniqueTopics() {
      const set = new Set(); questionLibrary.forEach(q => set.add(q.topic)); return Array.from(set);
    }

    function loadSavedFolderState() {
      try {
        const raw = safeGetStorage(FOLDER_STATE_STORAGE_KEY);
        if (raw) folderOpenState = JSON.parse(raw);
        else getUniqueTopics().forEach(t => { folderOpenState[t] = true; });
      } catch (e) { folderOpenState = {}; }
    }

    function saveFolderState() { safeSetStorage(FOLDER_STATE_STORAGE_KEY, JSON.stringify(folderOpenState)); }
    function toggleFolder(topic) { folderOpenState[topic] = !folderOpenState[topic]; saveFolderState(); renderLibraryList(); }
    function toggleAllFolders(open) { getUniqueTopics().forEach(t => { folderOpenState[t] = open; }); saveFolderState(); renderLibraryList(); }

    function loadSavedLibraryOrder() {
      try {
        const rawOrder = safeGetStorage(ORDER_STORAGE_KEY);
        if (!rawOrder) return;
        const idOrder = JSON.parse(rawOrder);
        if (Array.isArray(idOrder) && idOrder.length > 0) applyLibraryOrderArray(idOrder);
      } catch (e) { console.error(e); }
    }

    function applyLibraryOrderArray(idOrder) {
      const map = new Map(questionLibrary.map(q => [q.id, q]));
      const ordered = [];
      idOrder.forEach(id => { if (map.has(id)) { ordered.push(map.get(id)); map.delete(id); } });
      map.forEach(q => ordered.push(q));
      questionLibrary = ordered;
    }

    function saveLibraryOrder() {
      safeSetStorage(ORDER_STORAGE_KEY, JSON.stringify(questionLibrary.map(q => q.id)));
      flashOrderSavedIndicator("Library order saved permanently &#10003;");
    }

    function flashOrderSavedIndicator(msg) {
      const el = document.getElementById("orderSavedIndicator");
      if (!el) return;
      el.innerHTML = `<span class="text-emerald-600 font-semibold">${msg}</span>`;
      clearTimeout(window.orderFlashTimer);
      window.orderFlashTimer = setTimeout(() => {
        el.innerHTML = `Use folder headers to expand/collapse units or bulk select problems. Reorder with <strong class="text-slate-700">&uarr; / &darr;</strong> or drag cards.`;
      }, 2400);
    }

    function moveQuestionOrder(qId, direction) {
      const q = questionLibrary.find(item => item.id === qId);
      if (!q) return;
      const sameFolderList = questionLibrary.filter(item => item.topic === q.topic);
      const targetFolderIdx = sameFolderList.findIndex(item => item.id === qId) + direction;
      if (targetFolderIdx < 0 || targetFolderIdx >= sameFolderList.length) return;
      const masterA = questionLibrary.findIndex(item => item.id === qId);
      const masterB = questionLibrary.findIndex(item => item.id === sameFolderList[targetFolderIdx].id);
      if (masterA === -1 || masterB === -1) return;
      [questionLibrary[masterA], questionLibrary[masterB]] = [questionLibrary[masterB], questionLibrary[masterA]];
      saveLibraryOrder(); renderLibraryList();
    }

    let defaultGitHubIdOrder = [];
    function resetLibraryOrder() {
      if (defaultGitHubIdOrder.length > 0) applyLibraryOrderArray(defaultGitHubIdOrder);
      safeRemoveStorage(ORDER_STORAGE_KEY);
      flashOrderSavedIndicator("Restored default question order &#10003;");
      renderLibraryList();
    }

    function handleDragStart(e, qId) { draggedQuestionId = qId; e.currentTarget.classList.add("dragging-card"); e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", qId); }
    function handleDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = "move"; e.currentTarget.classList.add("drag-over-card"); }
    function handleDragLeave(e) { e.currentTarget.classList.remove("drag-over-card"); }
    function handleDrop(e, targetQId) {
      e.preventDefault(); e.currentTarget.classList.remove("drag-over-card");
      if (!draggedQuestionId || draggedQuestionId === targetQId) return;
      const fromIdx = questionLibrary.findIndex(q => q.id === draggedQuestionId), toIdx = questionLibrary.findIndex(q => q.id === targetQId);
      if (fromIdx === -1 || toIdx === -1) return;
      questionLibrary.splice(toIdx, 0, questionLibrary.splice(fromIdx, 1)[0]);
      draggedQuestionId = null; saveLibraryOrder(); renderLibraryList();
    }
    function handleDragEnd(e) { e.currentTarget.classList.remove("dragging-card"); draggedQuestionId = null; }

    // =========================================================================
    // REORDER SELECTED QUESTIONS VIEW & "BUILD A REVIEW APP" FLOW
    // =========================================================================
    function syncSelectedQuestionsOrder() {
      const keptSet = new Set(selectedQuestionsOrder.filter(id => selectedQuestionIds.has(id)));
      const kept = Array.from(keptSet);
      questionLibrary.forEach(q => { if (selectedQuestionIds.has(q.id) && !keptSet.has(q.id)) kept.push(q.id); });
      selectedQuestionsOrder = kept;
    }

    function goToReorderView() {
      if (selectedQuestionIds.size === 0) return showMessageModal("Please check the box next to at least one question in the library before building a review app.", "No Questions Selected");
      syncSelectedQuestionsOrder(); switchView("reorder");
    }

    function randomizeSelectedQuestionsOrder() {
      if (selectedQuestionsOrder.length <= 1) return;
      for (let i = selectedQuestionsOrder.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [selectedQuestionsOrder[i], selectedQuestionsOrder[j]] = [selectedQuestionsOrder[j], selectedQuestionsOrder[i]];
      }
      renderReorderList();
      const statusEl = document.getElementById("reorderStatusIndicator");
      if (statusEl) statusEl.innerHTML = `<span class="text-violet-700 font-semibold">Selected questions randomly reordered! Click Randomize Order again to reshuffle, or drag cards to fine-tune.</span>`;
    }

    function moveSelectedQuestion(index, direction) {
      const targetIndex = index + direction;
      if (targetIndex < 0 || targetIndex >= selectedQuestionsOrder.length) return;
      [selectedQuestionsOrder[index], selectedQuestionsOrder[targetIndex]] = [selectedQuestionsOrder[targetIndex], selectedQuestionsOrder[index]];
      renderReorderList();
    }

    function startEditQuestionPosition(idx) {
      const badgeBtn = document.getElementById(`qpos-btn-${idx}`), inputEl = document.getElementById(`qpos-input-${idx}`);
      if (!badgeBtn || !inputEl) return;
      badgeBtn.classList.add("hidden"); inputEl.classList.remove("hidden");
      inputEl.value = String(idx + 1); inputEl.focus(); inputEl.select();
    }

    function handlePositionInputKey(e, fromIdx) {
      if (e.key === "Enter") { e.preventDefault(); e.target.blur(); }
      else if (e.key === "Escape") { e.preventDefault(); e.target.dataset.cancelled = "true"; renderReorderList(); }
    }

    function commitQuestionPosition(fromIdx, inputEl) {
      if (!inputEl || inputEl.dataset.cancelled === "true" || inputEl.dataset.committed === "true") return;
      inputEl.dataset.committed = "true";
      const raw = (inputEl.value || "").replace(/[^0-9]/g, "");
      if (!raw) { renderReorderList(); return; }
      let targetPos = parseInt(raw, 10);
      if (Number.isNaN(targetPos)) { renderReorderList(); return; }
      targetPos = Math.max(1, Math.min(selectedQuestionsOrder.length, targetPos));
      const toIdx = targetPos - 1;
      if (toIdx !== fromIdx && fromIdx >= 0 && fromIdx < selectedQuestionsOrder.length) {
        selectedQuestionsOrder.splice(toIdx, 0, selectedQuestionsOrder.splice(fromIdx, 1)[0]);
        const statusEl = document.getElementById("reorderStatusIndicator");
        if (statusEl) statusEl.innerHTML = `<span class="text-blue-700 font-semibold">Moved question from Q${fromIdx + 1} to Q${targetPos}.</span>`;
      }
      renderReorderList();
    }

    function handleReorderDragStart(e, index) { draggedReorderIndex = index; e.currentTarget.classList.add("dragging-card"); e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", String(index)); }
    function handleReorderDragOver(e) { e.preventDefault(); e.dataTransfer.dropEffect = "move"; e.currentTarget.classList.add("drag-over-card"); }
    function handleReorderDragLeave(e) { e.currentTarget.classList.remove("drag-over-card"); }
    function handleReorderDrop(e, targetIndex) {
      e.preventDefault(); e.currentTarget.classList.remove("drag-over-card");
      if (draggedReorderIndex === null || draggedReorderIndex === targetIndex) return;
      selectedQuestionsOrder.splice(targetIndex, 0, selectedQuestionsOrder.splice(draggedReorderIndex, 1)[0]);
      draggedReorderIndex = null; renderReorderList();
    }
    function handleReorderDragEnd(e) { e.currentTarget.classList.remove("dragging-card"); draggedReorderIndex = null; }

    function renderReorderList() {
      const countBadge = document.getElementById("reorderCountBadge");
      if (countBadge) countBadge.textContent = `${selectedQuestionsOrder.length} ${selectedQuestionsOrder.length === 1 ? 'Question' : 'Questions'} Selected`;
      const container = document.getElementById("reorderListContainer");
      if (!container) return;
      const qMap = new Map(questionLibrary.map(q => [q.id, q]));
      const orderedQuestions = selectedQuestionsOrder.map(id => qMap.get(id)).filter(Boolean);
      if (orderedQuestions.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center border border-slate-200 text-slate-500">No questions selected. Click "Back to Question Library" to select problems.</div>`;
        return;
      }
      container.innerHTML = orderedQuestions.map((q, idx) => {
        const isFirst = idx === 0, isLast = idx === orderedQuestions.length - 1, sampleVars = getSampleVars(q);
        const basePrompt = renderLibraryPrompt(q, sampleVars), isDiagramVisible = q.diagram && visibleDiagramIds.has(q.id);
        const diagramPreviewHTML = isDiagramVisible ? `<div class="mt-3 pt-3 border-t border-slate-100 cursor-default" onclick="event.stopPropagation()">${getDiagramSVG(q.diagram, sampleVars)}</div>` : "";
        const sampleSolutions = q.parts.map(p => {
          const val = p.solve(sampleVars), u = normalizeUnit(p.unit);
          const dispVal = p.solveMulti ? p.solveMulti(sampleVars).map(r => Number(r).toFixed(2)).join(", ") : (p.multiVals ? p.multiVals.map(k => sampleVars[k]).join(", ") : fmtSci(val, 3));
          return `<span class="px-2 py-0.5 rounded bg-emerald-50 mono text-[11px] text-emerald-700 border border-emerald-200">${getPartLabel(p, sampleVars).split('.')[0]}: <strong>${dispVal} ${u === 'No units' ? '(No units)' : u}</strong> ${p.expectedDirection ? '(' + p.expectedDirection + ')' : ''}</span>`;
        }).join(" ");
        return `
        <div draggable="true" ondragstart="handleReorderDragStart(event, ${idx})" ondragover="handleReorderDragOver(event)" ondragleave="handleReorderDragLeave(event)" ondrop="handleReorderDrop(event, ${idx})" ondragend="handleReorderDragEnd(event)" class="group cursor-grab active:cursor-grabbing rounded-2xl p-4 bg-white border border-slate-200 hover:border-blue-400 shadow-sm transition">
          <div class="flex items-start gap-3 sm:gap-4">
            <div class="flex flex-col items-center gap-1 pt-0.5 select-none" onclick="event.stopPropagation()">
              <button id="qpos-btn-${idx}" type="button" onclick="startEditQuestionPosition(${idx})" class="px-2 py-0.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold mono shadow-xs transition cursor-pointer">Q${idx + 1}</button>
              <input id="qpos-input-${idx}" type="text" inputmode="numeric" value="${idx + 1}" draggable="false" ondragstart="event.preventDefault(); event.stopPropagation();" onkeydown="handlePositionInputKey(event, ${idx})" onblur="commitQuestionPosition(${idx}, this)" class="hidden w-12 px-1 py-0.5 rounded-md bg-white text-blue-700 border-2 border-blue-600 text-xs font-extrabold mono text-center focus:outline-none focus:ring-2 focus:ring-blue-400 shadow-xs" />
              <button type="button" onclick="moveSelectedQuestion(${idx}, -1)" ${isFirst ? 'disabled' : ''} class="w-7 h-6 rounded-md bg-slate-100 hover:bg-blue-100 hover:text-blue-700 disabled:opacity-30 text-slate-600 border border-slate-200 flex items-center justify-center transition"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg></button>
              <button type="button" onclick="moveSelectedQuestion(${idx}, 1)" ${isLast ? 'disabled' : ''} class="w-7 h-6 rounded-md bg-slate-100 hover:bg-blue-100 hover:text-blue-700 disabled:opacity-30 text-slate-600 border border-slate-200 flex items-center justify-center transition"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></button>
            </div>
            <div class="pt-1 text-slate-400 group-hover:text-blue-500 transition select-none"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg></div>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <div class="flex flex-wrap items-center gap-2"><span class="px-2 py-0.5 rounded text-xs font-bold mono bg-slate-100 text-slate-700 border border-slate-200">${q.docNum}</span><span title="Question code (searchable)" class="px-2 py-0.5 rounded text-xs font-bold mono bg-blue-50 text-blue-700 border border-blue-200">${q.id}</span><h4 class="text-sm sm:text-base font-bold text-slate-900">${q.title}</h4></div>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200">${q.topic}</span>
                  ${q.diagram ? `<button type="button" onclick="event.stopPropagation(); toggleDiagramPreview('${q.id}')" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border transition flex items-center gap-1 cursor-pointer ${isDiagramVisible ? 'bg-purple-600 text-white border-purple-600 shadow-xs' : 'bg-purple-50 text-purple-700 border-purple-200 hover:bg-purple-100'}"><span>${isDiagramVisible ? 'Hide Diagram' : 'Diagram'}</span></button>` : ''}
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">${q.parts.length} Parts</span>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">${basePrompt}</p>${diagramPreviewHTML}
              <div class="mt-2.5 flex flex-wrap items-center gap-1.5"><span class="text-[11px] font-semibold text-slate-400 mr-1">Base Key:</span>${sampleSolutions}</div>
            </div>
          </div>
        </div>`;
      }).join("");
    }

    // =========================================================================
    // LIBRARY FILTERING, PAGINATION, SELECTION, AND RENDERING
    // =========================================================================
    function renderTagFilterPills() {
      const container = document.getElementById("topicFilterContainer");
      if (!container) return;
      const baseTags = [
        { label: "All Questions", value: "All", isUnit: false },
        { label: "Unit 1: Kinematics (All)", value: "Unit 1: Kinematics", isUnit: true },
        { label: "Unit 2: Force and Translational Dynamics (All)", value: "Unit 2: Force and Translational Dynamics", isUnit: true }
      ];
      const existingValues = new Set(baseTags.map(t => t.value));
      CED_UNITS.forEach(u => {
        if (!existingValues.has(u.tag) && questionLibrary.some(q => q.unitTag === u.tag)) {
          baseTags.splice(2, 0, { label: u.tag + " (All)", value: u.tag, isUnit: true });
          existingValues.add(u.tag);
        }
      });
      getUniqueTopics().forEach(topic => {
        if (!existingValues.has(topic)) {
          baseTags.push({ label: topic.replace(/^Unit \d+:\s*/, ""), value: topic, isUnit: false });
          existingValues.add(topic);
        }
      });
      container.innerHTML = baseTags.map(tag => {
        let count = tag.value === "All" ? questionLibrary.length : (tag.isUnit ? questionLibrary.filter(q => q.unitTag === tag.value).length : questionLibrary.filter(q => q.topic === tag.value).length);
        return `<button type="button" onclick="setFilterTag('${tag.value.replace(/'/g, "\\'")}')" class="px-2.5 py-1 rounded-full text-xs font-semibold transition border ${activeFilterTag === tag.value ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200'}">${tag.label} <span class="opacity-75">(${count})</span></button>`;
      }).join("");
    }

    function setFilterTag(tag) {
      activeFilterTag = tag; currentLibraryPage = 1;
      // Choosing a unit/topic shows each of its diagrams by default (you can still hide one with its Diagram button); "All" clears them.
      visibleDiagramIds = new Set();
      if (tag !== "All") {
        const isUnit = CED_UNITS.some(u => u.tag === tag);
        questionLibrary.forEach(q => { if (q.diagram && (isUnit ? q.unitTag === tag : q.topic === tag)) visibleDiagramIds.add(q.id); });
      } renderTagFilterPills(); renderLibraryList(); }
    function handleLibrarySearch() { currentLibraryPage = 1; renderLibraryList(); }

    function getFilteredQuestions() {
      const qStr = (document.getElementById("librarySearchInput")?.value || "").trim().toLowerCase();
      const isCedUnitFilter = CED_UNITS.some(u => u.tag === activeFilterTag);
      return questionLibrary.filter(q => {
        let matchesTag = activeFilterTag === "All" ? true : (isCedUnitFilter ? q.unitTag === activeFilterTag : q.topic === activeFilterTag);
        if (!matchesTag) return false;
        if (!qStr) return true;
        const promptPreview = renderFormattedPrompt(q).toLowerCase();
        return q.id.toLowerCase().includes(qStr) || q.docNum.toLowerCase().includes(qStr) || q.title.toLowerCase().includes(qStr) || q.topic.toLowerCase().includes(qStr) || (q.unitTag && q.unitTag.toLowerCase().includes(qStr)) || promptPreview.includes(qStr);
      });
    }

    function goToLibraryPage(page) { currentLibraryPage = page; renderLibraryList(); window.scrollTo({ top: 0, behavior: "smooth" }); }

    function renderLibraryPagination(totalItems, totalPages, startIdx, endIdx) {
      const topEl = document.getElementById("libraryPaginationTop"), bottomEl = document.getElementById("libraryPaginationBottom");
      if (!topEl || !bottomEl) return;
      if (totalItems === 0 || totalPages <= 1) {
        const simpleBar = totalItems > 0 ? `<div class="bg-white rounded-xl px-4 py-2.5 border border-slate-200 shadow-xs flex items-center justify-between text-xs text-slate-600"><span>Showing <strong>1&ndash;${totalItems}</strong> of <strong>${totalItems}</strong> problems</span><span class="font-semibold text-slate-500">Page 1 of 1</span></div>` : "";
        topEl.innerHTML = simpleBar; bottomEl.innerHTML = "";
        return;
      }
      let pageBtns = "";
      for (let p = 1; p <= totalPages; p++) pageBtns += `<button type="button" onclick="goToLibraryPage(${p})" class="w-8 h-8 rounded-lg text-xs font-bold border transition ${p === currentLibraryPage ? 'bg-blue-600 text-white border-blue-600 shadow-xs' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100'}">${p}</button>`;
      const barHTML = `<div class="bg-white rounded-xl px-4 py-2.5 border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600"><span>Showing <strong>${startIdx + 1}&ndash;${endIdx}</strong> of <strong>${totalItems}</strong> problems &bull; Page <strong>${currentLibraryPage}</strong> of <strong>${totalPages}</strong></span><div class="flex items-center gap-1.5"><button type="button" onclick="goToLibraryPage(${Math.max(1, currentLibraryPage - 1)})" ${currentLibraryPage === 1 ? 'disabled' : ''} class="px-3 py-1.5 rounded-lg font-semibold bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 disabled:opacity-40 transition">&larr; Prev</button>${pageBtns}<button type="button" onclick="goToLibraryPage(${Math.min(totalPages, currentLibraryPage + 1)})" ${currentLibraryPage === totalPages ? 'disabled' : ''} class="px-3 py-1.5 rounded-lg font-semibold bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 disabled:opacity-40 transition">Next &rarr;</button></div></div>`;
      topEl.innerHTML = barHTML; bottomEl.innerHTML = barHTML;
    }

    function copyQuestionText(qId, btnEl) {
      const q = questionLibrary.find(item => item.id === qId);
      if (!q) return;
      const sampleVars = getSampleVars(q);
      const rawHTML = renderLibraryPrompt(q, sampleVars).replace(/<br\s*\/?>/gi, "\n").replace(/<\/?strong>/gi, "").replace(/<\/?em>/gi, "").replace(/<sub>(.*?)<\/sub>/gi, "_$1").replace(/<sup>(.*?)<\/sup>/gi, "^$1");
      const tmp = document.createElement("div"); tmp.innerHTML = rawHTML;
      const cleanPrompt = tmp.textContent || tmp.innerText || "";
      const keySummary = (q.parts||[]).map(p => {
        const val = p.solve(sampleVars), u = normalizeUnit(p.unit);
        const dispVal = p.solveMulti ? p.solveMulti(sampleVars).map(r => Number(r).toFixed(2)).join(", ") : (p.multiVals ? p.multiVals.map(k => sampleVars[k]).join(", ") : fmtSci(val, 4));
        return `${getPartLabel(p, sampleVars).replace(/<[^>]+>/g, "")}: ${dispVal} ${u}`;
      }).join(" | ");
      const fullCopyText = `${q.docNum} — ${q.title} (${q.id})\n${cleanPrompt}\nAnswer Key: ${keySummary}`;
      const ta = document.createElement("textarea"); ta.value = fullCopyText; ta.style.position = "fixed"; ta.style.left = "-9999px";
      document.body.appendChild(ta); ta.select();
      try {
        document.execCommand("copy");
