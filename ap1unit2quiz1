        defaultAppName: "Honors Physics Review",
        namePlaceholder: "e.g., Honors Physics Unit 1 and 2 Review"
      }
    };

    function applyTemplateSettings(templateName) {
      const cfg = TEMPLATE_CONFIG[templateName] || TEMPLATE_CONFIG["AP Physics 1"];
      const link = document.getElementById("equationSheetLink");
      if (link) link.href = cfg.equationSheetUrl;
      const title = document.getElementById("modalTemplateSettingsTitle");
