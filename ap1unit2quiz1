    // SAVED RECIPES: a small text file that remembers a review app's name, template, number mode and question order,
    // so the app can be rebuilt (and edited) later without picking every question again.
    // =========================================================================
    function buildRecipeObject(fromReview) {
      let ids, name, template, mode;
      if (fromReview && currentReviewApp && Array.isArray(currentReviewApp.questions) && currentReviewApp.questions.length > 0) {
        ids = currentReviewApp.questions.map(q => q.id);
        name = currentReviewApp.name;
        template = currentReviewApp.template;
        mode = randomizationMode;
      } else {
        if (selectedQuestionsOrder.length === 0) syncSelectedQuestionsOrder();
        ids = [...selectedQuestionsOrder];
        name = (document.getElementById("reviewAppNameInput").value || "").trim();
        template = document.getElementById("templateSelect").value;
        mode = document.getElementById("randomizationModeSelect").value;
      }
      if (mode !== "static") mode = "random";
      const recipe = {
        note: "Physics Review App Recipe. Open this file with the Load Recipe button in the Physics Question Library.",
        recipeVersion: 1,
        appName: name || "Review App",
        template: template,
        randomizationMode: mode,
        questionCount: ids.length,
        savedOn: new Date().toISOString().slice(0, 10),
        questionIds: ids
      };
      if (mode === "static") {
        const sv = {};
        ids.forEach(id => { if (staticVarsStore && staticVarsStore[id]) sv[id] = staticVarsStore[id]; });
        if (Object.keys(sv).length > 0) recipe.staticVars = sv;
      }
      return recipe;
    }

    function saveRecipe(source) {
      try {
        const recipe = buildRecipeObject(source === "review");
        if (recipe.questionIds.length === 0) return showMessageModal("There are no questions to save yet. Check the box next to at least one question first.", "Nothing to Save");
        const blob = new Blob([JSON.stringify(recipe, null, 2)], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = (recipe.appName.replace(/[^A-Za-z0-9 _-]+/g, "").trim().replace(/\s+/g, " ") || "Review App") + " Recipe.txt";
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      } catch (err) {
        console.error(err);
        showMessageModal("The recipe could not be saved: " + (err && err.message ? err.message : err), "Save Recipe Error");
      }
    }

