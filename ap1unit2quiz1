    function selectFolderQuestions(topic, select) {
      questionLibrary.forEach(q => { if (q.topic === topic) { if (select) selectedQuestionIds.add(q.id); else selectedQuestionIds.delete(q.id); } });
      syncSelectedQuestionsOrder(); renderLibraryList();
    }

    function selectCurrentPageQuestions(select = true) {
      const filtered = getFilteredQuestions(), startIdx = (currentLibraryPage - 1) * PROBLEMS_PER_PAGE;
      filtered.slice(startIdx, Math.min(startIdx + PROBLEMS_PER_PAGE, filtered.length)).forEach(q => { if (select) selectedQuestionIds.add(q.id); else selectedQuestionIds.delete(q.id); });
      syncSelectedQuestionsOrder(); renderLibraryList();
    }

    function toggleQuestionSelection(qId) {
      if (selectedQuestionIds.has(qId)) selectedQuestionIds.delete(qId); else selectedQuestionIds.add(qId);
      syncSelectedQuestionsOrder(); renderLibraryList();
    }

    function selectFilteredQuestions(select) {
      getFilteredQuestions().forEach(q => { if (select) selectedQuestionIds.add(q.id); else selectedQuestionIds.delete(q.id); });
      syncSelectedQuestionsOrder(); renderLibraryList();
    }

    function clearAllSelections() { selectedQuestionIds.clear(); selectedQuestionsOrder = []; renderLibraryList(); }
    function updateTemplateConfig() { randomizationMode = document.getElementById("randomizationModeSelect").value; }

    // ---- TEMPLATES ------------------------------------------------------------
    // Each template sets the Equation Sheet link and the default name of a new review app.
    const TEMPLATE_CONFIG = {
      "AP Physics 1": {
        equationSheetUrl: "https://apcentral.collegeboard.org/media/pdf/ap-physics-1-equations-sheet.pdf",
        defaultAppName: "AP Physics 1 Review",
