      const nameInput = document.getElementById("reviewAppNameInput");
      if (nameInput) {
        nameInput.placeholder = cfg.namePlaceholder;
        // Swap the suggested name only if the teacher hasn't typed their own.
        const stockNames = Object.keys(TEMPLATE_CONFIG).map(k => TEMPLATE_CONFIG[k].defaultAppName);
        if (!nameInput.value.trim() || stockNames.includes(nameInput.value.trim())) nameInput.value = cfg.defaultAppName;
      }
    }

    function onModalTemplateChanged() { applyTemplateSettings(document.getElementById("modalTemplateSelect").value); }
    function onTemplateChanged() { applyTemplateSettings(document.getElementById("templateSelect").value); }

    function openBuildModal() {
      if (selectedQuestionIds.size === 0) return showMessageModal("Please check the box next to at least one question in the library before building a review app.", "No Questions Selected");
      if (selectedQuestionsOrder.length === 0) syncSelectedQuestionsOrder();
      applyTemplateSettings(document.getElementById("templateSelect").value);
      document.getElementById("modalQuestionCount").textContent = `${selectedQuestionsOrder.length} Selected`;
      document.getElementById("buildAppModal").classList.remove("hidden");
      document.getElementById("reviewAppNameInput").focus();
    }

    function closeBuildModal() { document.getElementById("buildAppModal").classList.add("hidden"); }

    function initializeReviewAppFromSelection() {
      // A brand-new build picks a fresh set of static numbers; an exported app being edited keeps its saved numbers.
      if (!window.STANDALONE_BOOT_CONFIG) staticVarsStore = {};
      const nameInput = document.getElementById("reviewAppNameInput").value.trim() || "AP Physics 1 Review App";
      const templateName = document.getElementById("templateSelect").value;
      randomizationMode = document.getElementById("randomizationModeSelect").value;

      if (selectedQuestionsOrder.length === 0) syncSelectedQuestionsOrder();
      const qMap = new Map(questionLibrary.map(q => [q.id, q]));
      const chosenQuestions = selectedQuestionsOrder.map(id => qMap.get(id)).filter(Boolean);

      currentReviewApp.name = nameInput;
      currentReviewApp.template = templateName;
      applyTemplateSettings(templateName);
      document.getElementById("reviewAppNameInput").value = nameInput;
      currentReviewApp.questions = chosenQuestions;
      currentReviewApp.currentIndex = 0;
      currentReviewApp.instances = {};

      chosenQuestions.forEach(q => { currentReviewApp.instances[q.id] = createQuestionInstance(q); });
    }

    function createQuestionInstance(q) {
      const base = getSampleVars(q);
      let vars = { ...base };
      if (randomizationMode === "static") {
        if (!staticVarsStore[q.id]) {
          const start = (q.baseVars && typeof q.baseVars === "object") ? { ...q.baseVars } : { ...base };
          let chosen = start;
          if (typeof q.randomize === "function") {
            try { chosen = { ...start, ...q.randomize(start) }; }
            catch (err) { console.error("randomize() failed for " + q.id + ":", err); }
          }
          staticVarsStore[q.id] = chosen;
        }
        vars = { ...staticVarsStore[q.id] };
      } else if (randomizationMode === "random" && typeof q.randomize === "function") {
        try { vars = { ...base, ...q.randomize(base) }; }
        catch (err) { console.error("randomize() failed for " + q.id + ", using original values:", err); vars = { ...base }; }
      }
      return {
        vars,
        partStates: (q.parts||[]).map(() => ({ attempts: 0, completed: false, showSolution: false, userVal: "", userUnit: "", userDir: "", feedback: null }))
      };
    }

    function buildAndLaunchReviewApp() {
      try {
        initializeReviewAppFromSelection();
        closeBuildModal();
        switchView("student");
      } catch (err) {
        console.error(err);
        showMessageModal("The review app could not be built: " + (err && err.message ? err.message : err), "Build Error");
      }
    }

    // Creator shortcut inside an exported app: Ctrl+Shift+E shows or hides the button that returns to the library.
    document.addEventListener("keydown", e => {
      if (!window.STANDALONE_BOOT_CONFIG || !(e.ctrlKey || e.metaKey) || !e.shiftKey || String(e.key).toLowerCase() !== "e") return;
      e.preventDefault();
      const backBtn = document.getElementById("backToConstructorBtn");
      if (!backBtn) return;
      const hiding = backBtn.style.display !== "none";
      backBtn.style.display = hiding ? "none" : "";
      setCreatorToolsVisible(!hiding);
      if (!hiding) renderLibraryList();
    });

    function switchView(target) {
      const constructorView = document.getElementById("constructorView"), reorderView = document.getElementById("reorderView"), studentView = document.getElementById("studentReviewView");
      const backBtn = document.getElementById("backToConstructorBtn"), reviewToolbar = document.getElementById("reviewToolbarItems");
      const headerTitle = document.getElementById("headerTitle"), headerSubtitle = document.getElementById("headerSubtitle"), modeBadge = document.getElementById("modeBadge");

      if (target === "student") {
        constructorView.classList.add("hidden"); reorderView.classList.add("hidden"); studentView.classList.remove("hidden");
        backBtn.classList.remove("hidden"); backBtn.classList.add("flex"); reviewToolbar.classList.remove("hidden"); reviewToolbar.classList.add("flex");
        headerTitle.textContent = currentReviewApp.name; headerSubtitle.classList.add("hidden"); modeBadge.classList.add("hidden");
        renderStudentReviewApp();
      } else if (target === "reorder") {
        constructorView.classList.add("hidden"); studentView.classList.add("hidden"); reorderView.classList.remove("hidden");
        backBtn.classList.remove("hidden"); backBtn.classList.add("flex"); reviewToolbar.classList.add("hidden"); reviewToolbar.classList.remove("flex");
        headerTitle.textContent = "Arrange Selected Questions"; headerSubtitle.textContent = "Drag questions up or down or randomize their sequence before creating your review app.";
        headerSubtitle.classList.remove("hidden"); modeBadge.textContent = "Step 2 of 2"; modeBadge.classList.remove("hidden");
        // Show every selected problem's diagram expanded while arranging (remember the library's own choices to restore on the way back).
        if (!diagramStateBeforeArrange) diagramStateBeforeArrange = new Set(visibleDiagramIds);
        const qById = new Map(questionLibrary.map(q => [q.id, q]));
        selectedQuestionsOrder.forEach(id => { const q = qById.get(id); if (q && q.diagram) visibleDiagramIds.add(id); });
        renderReorderList(); window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        studentView.classList.add("hidden"); reorderView.classList.add("hidden"); constructorView.classList.remove("hidden");
        if (diagramStateBeforeArrange) { visibleDiagramIds = diagramStateBeforeArrange; diagramStateBeforeArrange = null; }
        backBtn.classList.add("hidden"); backBtn.classList.remove("flex"); reviewToolbar.classList.add("hidden"); reviewToolbar.classList.remove("flex");
        headerTitle.textContent = "Physics Question Library and Constructor"; headerSubtitle.textContent = "";
        headerSubtitle.classList.add("hidden"); modeBadge.textContent = "Teacher Studio"; modeBadge.classList.remove("hidden");
      }
    }

    // =========================================================================
    // STUDENT REVIEW APP RENDERING & GRADING
    // =========================================================================
    // ---- QUESTION NAVIGATION (single row) ----------------------------------------
    function renderQuestionNav() {
      const qs = currentReviewApp.questions;
      const navContainer = document.getElementById("questionNavPills");
      if (!navContainer || !qs || qs.length === 0) return;

      const isDone = idx => {
        const inst = currentReviewApp.instances[qs[idx].id];
        return !!(inst && inst.partStates && inst.partStates.length > 0 && inst.partStates.every(ps => ps.completed));
      };
      const pillHTML = idx => {
        const allDone = isDone(idx), isCurrent = idx === currentReviewApp.currentIndex;
        let colorCls = "bg-slate-100 text-slate-700 hover:bg-slate-200 border-slate-200";
        if (allDone) colorCls = "bg-emerald-50 text-emerald-700 border-emerald-300";
        if (isCurrent) colorCls = "bg-blue-600 text-white border-blue-600 font-bold shadow-sm";
        return `<button onclick="goToReviewQuestion(${idx})" class="w-12 h-7 px-1 rounded-lg text-xs border transition inline-flex items-center justify-center gap-0.5 shrink-0 ${colorCls}"><span>Q${idx + 1}</span>${allDone ? '<span class="text-[10px] leading-none">&#10003;</span>' : ''}</button>`;
      };

      const n = qs.length;
      const width = navContainer.clientWidth || 900;
      const PILL_SLOT = 54;   // one question button plus its gap

      // Everything fits on one row: show the individual question buttons.
      if (n * PILL_SLOT <= width) {
        navContainer.innerHTML = qs.map((q, idx) => pillHTML(idx)).join("");
        return;
      }

      // Otherwise group them. Up to 5 groups across; fewer when the window is narrow.
      const maxGroups = width >= 860 ? 5 : (width >= 680 ? 4 : (width >= 500 ? 3 : 2));
      const groupSize = Math.ceil(n / maxGroups);
      const groupCount = Math.ceil(n / groupSize);
      let html = "";
      for (let g = 0; g < groupCount; g++) {
        const first = g * groupSize, last = Math.min(n, first + groupSize) - 1;
        let allDone = true, hasCurrent = false, inner = "";
        for (let i = first; i <= last; i++) {
          if (!isDone(i)) allDone = false;
          if (i === currentReviewApp.currentIndex) hasCurrent = true;
          inner += pillHTML(i);
        }
        let colorCls = "bg-slate-100 text-slate-700 hover:bg-slate-200 border-slate-200";
        if (allDone) colorCls = "bg-emerald-50 text-emerald-700 border-emerald-300";
        if (hasCurrent) colorCls = "bg-blue-600 text-white border-blue-600 font-bold shadow-sm";
        const label = first === last ? `Question ${first + 1}` : `Questions ${first + 1} - ${last + 1}`;
        const alignRight = g >= Math.ceil(groupCount / 2);
        html += `<div class="qgroup"><button type="button" onclick="toggleQuestionGroup(this)" style="font-size:calc(0.75rem + 2pt)" class="h-7 px-3 rounded-lg text-xs border transition inline-flex items-center justify-center gap-1 whitespace-nowrap ${colorCls}"><span>${label}</span>${allDone ? '<span class="text-[10px] leading-none">&#10003;</span>' : ''}</button><div class="qgroup-pop${alignRight ? ' right' : ''}"><div class="qgroup-pop-inner">${inner}</div></div></div>`;
      }
      navContainer.innerHTML = html;
    }

    // Keep a pop-up inside the window (matters on narrow screens): nudge it sideways if it would spill out.
    function positionQuestionPop(group) {
      const pop = group && group.querySelector(".qgroup-pop");
      if (!pop) return;
      pop.style.transform = "";
      const r = pop.getBoundingClientRect(), vw = document.documentElement.clientWidth || window.innerWidth, margin = 6;
      if (r.left < margin) pop.style.transform = "translateX(" + (margin - r.left) + "px)";
      else if (r.right > vw - margin) pop.style.transform = "translateX(" + (vw - margin - r.right) + "px)";
    }
    document.addEventListener("mouseover", e => {
      const group = e.target.closest ? e.target.closest("#questionNavPills .qgroup") : null;
      if (group) positionQuestionPop(group);
    });

    // Tap/click support for screens without hover: open one group at a time; tapping elsewhere closes it.
    function toggleQuestionGroup(btn) {
      const group = btn.parentElement, wasOpen = group.classList.contains("open");
      document.querySelectorAll("#questionNavPills .qgroup.open").forEach(el => el.classList.remove("open"));
      if (!wasOpen) { group.classList.add("open"); positionQuestionPop(group); }
    }
    document.addEventListener("click", e => {
      if (!e.target.closest || e.target.closest("#questionNavPills .qgroup")) return;
      document.querySelectorAll("#questionNavPills .qgroup.open").forEach(el => el.classList.remove("open"));
    });
    let navResizeTimer = null;
