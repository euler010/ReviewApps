        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
          <button onclick="goToReviewQuestion(${Math.max(0, currentReviewApp.currentIndex - 1)})" ${currentReviewApp.currentIndex === 0 ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 disabled:opacity-40 hover:bg-slate-200 transition">&larr; Previous Problem</button>
          <button onclick="goToReviewQuestion(${Math.min(qs.length - 1, currentReviewApp.currentIndex + 1)})" ${currentReviewApp.currentIndex === qs.length - 1 ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 disabled:opacity-40 hover:bg-slate-200 transition">Next Problem &rarr;</button>
