                    ${q.diagram ? `<button type="button" onclick="event.stopPropagation(); toggleDiagramPreview('${q.id}')" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border transition flex items-center gap-1 cursor-pointer ${isDiagramVisible ? 'bg-purple-600 text-white border-purple-600 shadow-xs' : 'bg-purple-50 text-purple-700 border-purple-200 hover:bg-purple-100'}"><span>${isDiagramVisible ? 'Hide Diagram' : 'Diagram'}</span></button>` : ''}
