    // ---- Exporting: each review app carries its own questions and diagram code (nothing is loaded from GitHub). ----

    // Turns a function into source text that can be pasted into a new page.
    function functionSourceText(fn) {
      const s = fn.toString();
      try { new Function("return (" + s + ");"); return s; }
      catch (e) { return "function " + s; }   // method shorthand such as  renderPrompt(v) { ... }
    }

    // Turns a question (or any part of one) into JavaScript source text. Fields starting with "_" are app bookkeeping and are skipped.
    function serializeForExport(val) {
      if (typeof val === "function") return functionSourceText(val);
      if (Array.isArray(val)) return "[" + val.map(serializeForExport).join(",\n") + "]";
      if (val && typeof val === "object") {
        return "{" + Object.keys(val).filter(k => k.charAt(0) !== "_" && val[k] !== undefined)
          .map(k => JSON.stringify(k) + ": " + serializeForExport(val[k])).join(",\n") + "}";
      }
      if (typeof val === "number" && !isFinite(val)) return String(val);
      return val === undefined ? "undefined" : JSON.stringify(val);
    }

    // Builds the question-and-diagram script that gets written into an exported app.
    function buildEmbeddedDataScript(ids) {
      const bank = (typeof PHYSICS_QUESTIONS !== "undefined" && Array.isArray(PHYSICS_QUESTIONS)) ? PHYSICS_QUESTIONS : [];
      const picked = ids.map(id => bank.find(q => q.id === id) || questionLibrary.find(q => q.id === id)).filter(Boolean);
      const questionsText = "[" + picked.map(serializeForExport).join(",\n") + "]";

      const usedDiagrams = [...new Set(picked.map(q => q.diagram).filter(d => typeof d === "string"))]
        .filter(d => typeof DIAGRAM_DRAWERS !== "undefined" && DIAGRAM_DRAWERS[d]);
      const drawersText = "const DIAGRAM_DRAWERS = {\n" + usedDiagrams.map(d => JSON.stringify(d) + ": " + functionSourceText(DIAGRAM_DRAWERS[d])).join(",\n") + "\n};\n"
        + "function getDiagramSVG(type, v) { const draw = DIAGRAM_DRAWERS[type]; return draw ? draw(v) : ''; }\n";

      let code = "";
      const needsSpline = /\b(buildSplineModel|generateSplineProblemVars|buildInteractiveSplineSVG|syncSplineStateWithVars)\b/.test(questionsText + drawersText);
      if (needsSpline && typeof installSplineEngine === "function") code += functionSourceText(installSplineEngine) + "\ninstallSplineEngine();\n";
      if (typeof guidedSteps === "function") code += functionSourceText(guidedSteps) + "\n";
      code += drawersText + "const PHYSICS_QUESTIONS = " + questionsText + ";\n";
      return code.replace(/<\//g, "<\\/");   // keeps the browser from ending the script early
    }

    // Builds the complete HTML text of the review app as it currently stands in the library.
    function buildStandaloneHTML() {
      if (selectedQuestionsOrder.length === 0) syncSelectedQuestionsOrder();
      const fixedSelectedArray = [...selectedQuestionsOrder];
      const openScr = "<" + "script", closeScr = "<" + "/script>", closeBody = "<" + "/body>", docType = "<!DOC" + "TYPE html>\n";

      let fullSource = document.documentElement.outerHTML;
      // Drop the old boot script (when this file is itself an exported app being edited).
      fullSource = fullSource.replace(/<script>window\.STANDALONE_BOOT_CONFIG = [\s\S]*?;<\/script>/g, "");
      // Drop the copy of the question file this page fetched from GitHub; the exported app gets its own embedded copy below.
      fullSource = fullSource.replace(/<script id="fetchedQuestionData">[\s\S]*?<\/script>/, "");
      // Replace the question file link (or an earlier embedded copy) with this app's own questions and diagrams.
      const embedded = openScr + ' id="embeddedQuestionData">\n' + buildEmbeddedDataScript(fixedSelectedArray) + closeScr;
      // (Built from pieces so this code never contains the exact text it searches for.)
      const linkPattern = new RegExp("<" + "script[^>]*physics_questions_data\\.js[^>]*><" + "/script>");
      const embeddedPattern = new RegExp("<" + "script id=\"embeddedQuestionData\">[\\s\\S]*?<" + "/script>");
      if (embeddedPattern.test(fullSource)) fullSource = fullSource.replace(embeddedPattern, () => embedded);
      else if (linkPattern.test(fullSource)) fullSource = fullSource.replace(linkPattern, () => embedded);
      else throw new Error("Could not find the question data in this page.");

      const bootConfig = { orderedIds: fixedSelectedArray, selectedIds: fixedSelectedArray, appName: currentReviewApp.name, template: currentReviewApp.template, randomizationMode: randomizationMode, staticVars: (randomizationMode === "static" ? staticVarsStore : null) };
      const bootScript = openScr + ">window.STANDALONE_BOOT_CONFIG = " + JSON.stringify(bootConfig) + ";" + closeScr + closeBody;
      return docType + fullSource.replace(closeBody, () => bootScript);
    }

    function downloadStandaloneReviewApp() {
      const standaloneHTML = buildStandaloneHTML();
      const blob = new Blob([standaloneHTML], { type: "text/html" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a"); a.href = url;
      a.download = (currentReviewApp.name || "Review_App").toLowerCase().replace(/[^a-z0-9]+/g, "-") + ".html";
      a.click(); URL.revokeObjectURL(url);
    }

    // Copies the app's HTML to the clipboard, ready to paste into a Google Sites "Embed code" box.
    function copyStandaloneHtml() {
      let html;
      try { html = buildStandaloneHTML(); }
      catch (err) { console.error(err); showMessageModal("The HTML could not be created: " + (err && err.message ? err.message : err), "Copy Error"); return; }
      const done = () => {
        const b = document.getElementById("copyHtmlBtn");
        if (b) { const old = b.innerHTML; b.textContent = "Copied!"; setTimeout(() => { b.innerHTML = old; }, 1800); }
      };
      const fallback = () => {
        const ta = document.createElement("textarea");
        ta.value = html; ta.style.position = "fixed"; ta.style.left = "-9999px";
        document.body.appendChild(ta); ta.select();
        let ok = false;
        try { ok = document.execCommand("copy"); } catch (e) {}
        document.body.removeChild(ta);
        if (ok) done(); else showMessageModal("Your browser blocked copying. Use Export Standalone HTML instead, then open that file in a text editor and copy its contents.", "Copy Blocked");
      };
      if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(html).then(done, fallback); }
      else { fallback(); }
    }

    // The Export and Copy buttons are for the creator only. Exported apps hide them unless opened in edit mode.
